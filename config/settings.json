{
  "vim.leader": "<space>",
  "vim.useCtrlKeys": true,
  "vim.hlsearch": true,
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": [
        "<C-w>",
        "s"
      ],
      "commands": [
        "workbench.action.splitEditorDown"
      ]
    },
    {
      "before": [
        "<C-w>",
        "h"
      ],
      "commands": [
        "workbench.action.splitEditorRight"
      ]
    },
    {
      "before": [
        "<C-w>",
        "<C-s>"
      ],
      "commands": [
        "workbench.action.splitEditorDown"
      ]
    },
    {
      "before": [
        "<C-w>",
        "<C-h>"
      ],
      "commands": [
        "workbench.action.splitEditorRight"
      ]
    },
    {
      "before": [
        "z",
        "o"
      ],
      "after": [
        "z",
        "a"
      ]
    },
    {
      "before": [
        "<Enter>"
      ],
      "after": [
        "v",
        "i",
        "w"
      ]
    },
    {
      "before": [
        "<leader>",
        "q"
      ],
      "commands": [
        "workbench.action.closeActiveEditor"
      ]
    },
    {
      "before": [
        "H"
      ],
      "commands": [
        "workbench.action.previousEditor"
      ]
    },
    {
      "before": [
        "L"
      ],
      "commands": [
        "workbench.action.nextEditor"
      ]
    },
    {
      "before": [
        "<leader>",
        "n"
      ],
      "commands": [
        "vimNavigation.toggleExplorer"
      ]
    },
    {
      "before": [
        "*"
      ],
      "after": [
        "m",
        "'",
        "*",
        "`",
        "'"
      ]
    },
    {
      "before": [
        "z",
        "f"
      ],
      "after": [
        "z",
        "f"
      ]
    },
    {
      "before": [
        "z",
        "d"
      ],
      "after": [
        "z",
        "d"
      ]
    },
    {
      "before": [
        "<leader>",
        "h"
      ],
      "commands": [
        {
          "command": "colorMarks.toggle",
          "args": {
            "visual": false
          }
        }
      ]
    },
    {
      "before": [
        "<leader>",
        "H"
      ],
      "commands": [
        {
          "command": "colorMarks.remove",
          "args": {
            "visual": false
          }
        }
      ]
    },
    {
      "before": [
        "<leader>",
        "1"
      ],
      "commands": [
        {
          "command": "colorMarks.blue",
          "args": {
            "visual": false
          }
        }
      ]
    },
    {
      "before": [
        "<leader>",
        "2"
      ],
      "commands": [
        {
          "command": "colorMarks.pink",
          "args": {
            "visual": false
          }
        }
      ]
    },
    {
      "before": [
        "<leader>",
        "3"
      ],
      "commands": [
        {
          "command": "colorMarks.green",
          "args": {
            "visual": false
          }
        }
      ]
    },
    {
      "before": [
        "<leader>",
        "4"
      ],
      "commands": [
        {
          "command": "colorMarks.yellow",
          "args": {
            "visual": false
          }
        }
      ]
    },
    {
      "before": [
        "<leader>",
        "0"
      ],
      "commands": [
        {
          "command": "colorMarks.clearAll",
          "args": {
            "visual": false
          }
        }
      ]
    },
    {
      "before": [
        "]",
        "h"
      ],
      "commands": [
        "colorMarks.next"
      ]
    },
    {
      "before": [
        "[",
        "h"
      ],
      "commands": [
        "colorMarks.previous"
      ]
    },
    {
      "before": [
        "<leader>",
        "i",
        "m",
        "e"
      ],
      "commands": [
        "editorImeMode.toggleCommandLineEnglish"
      ]
    },
    {
      "before": [
        "<C-s>"
      ],
      "commands": [
        "workbench.action.files.save"
      ]
    },
    {
      "before": [
        "<C-h>"
      ],
      "commands": [
        "workbench.action.navigateLeft"
      ]
    },
    {
      "before": [
        "z",
        "F"
      ],
      "after": [
        "z",
        "f",
        "_"
      ]
    },
    {
      "before": [
        "z",
        "D"
      ],
      "commands": [
        "gvimMarkerFolds.deleteFoldRecursive"
      ]
    },
    {
      "before": [
        "z",
        "E"
      ],
      "commands": [
        "gvimMarkerFolds.deleteAllFolds"
      ]
    },
    {
      "before": [
        "z",
        "A"
      ],
      "commands": [
        "gvimMarkerFolds.toggleFoldRecursive"
      ]
    },
    {
      "before": [
        "z",
        "v"
      ],
      "commands": [
        "gvimMarkerFolds.viewCursor"
      ]
    },
    {
      "before": [
        "z",
        "m"
      ],
      "commands": [
        "gvimMarkerFolds.foldMore"
      ]
    },
    {
      "before": [
        "z",
        "r"
      ],
      "commands": [
        "gvimMarkerFolds.foldLess"
      ]
    },
    {
      "before": [
        "z",
        "n"
      ],
      "commands": [
        "gvimMarkerFolds.disableFolds"
      ]
    },
    {
      "before": [
        "z",
        "N"
      ],
      "commands": [
        "gvimMarkerFolds.enableFolds"
      ]
    },
    {
      "before": [
        "z",
        "i"
      ],
      "commands": [
        "gvimMarkerFolds.toggleFolds"
      ]
    },
    {
      "before": [
        "z",
        "j"
      ],
      "commands": [
        "gvimMarkerFolds.nextFold"
      ]
    },
    {
      "before": [
        "z",
        "k"
      ],
      "commands": [
        "gvimMarkerFolds.previousFold"
      ]
    },
    {
      "before": [
        "[",
        "z"
      ],
      "commands": [
        "gvimMarkerFolds.foldStart"
      ]
    },
    {
      "before": [
        "]",
        "z"
      ],
